{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quicknote-capability",
  "description": "Frameless quick-note window: submit a note through IPC and hide itself.",
  "windows": ["quicknote"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging"
  ]
